{
  "name": "gaydex-circuit",
  "version": "1.0.0",
  "private": true,
  "description": "GayDex: Circuit \u2014 a Three.js-powered spatial GayDex. Single-file production artifact, no runtime dependencies.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "roundtrip": "node tools/build.mjs --roundtrip",
    "extract": "node tools/extract-original-engine.mjs",
    "icons": "node tools/make-icons.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:engine": "node --test tests/battle-equivalence.test.mjs",
    "test:world": "node --test tests/circuit-world.test.mjs",
    "test:boot": "node --test tests/jsdom-boot.test.mjs",
    "verify": "node tools/build.mjs --roundtrip && node --test \"tests/*.test.mjs\" && node tools/build.mjs --check",
    "preview:duel": "node tools/preview-duel.mjs"
  },
  "devDependencies": {
    "jsdom": "25.0.1"
  },
  "pinnedDependencies": {
    "three": "0.186.1",
    "note": "three is vendored at vendor/three.iife.min.js (built from three@0.186.1 with esbuild@0.24.0). The production artifact has ZERO runtime dependencies and makes no network requests."
  }
}
